# rollenspiel.ai - Environment Variables Example
# Copy this file to .env and fill in your values

# ============================================
# ANTHROPIC API KEY (REQUIRED for production)
# ============================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# VERCEL DEPLOYMENT (Optional - for CI/CD)
# ============================================
# Get these from Vercel project settings
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id
VERCEL_TOKEN=your_vercel_token

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
# Enable demo mode (uses mock data, no API needed)
VITE_DEMO_MODE=false

# Enable analytics tracking
VITE_ANALYTICS_ENABLED=false

# ============================================
# DEVELOPMENT (Optional)
# ============================================
# Node environment
NODE_ENV=development

# API base URL (override in production)
# VITE_API_BASE_URL=http://localhost:3000/api
