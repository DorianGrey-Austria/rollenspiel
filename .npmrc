# NPM Configuration for optimal builds

# Faster installs
prefer-offline=true
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Production optimizations
production=true
optional=false

# Lockfile
package-lock=true

# Engine strict (enforce Node version)
engine-strict=true

# Progress display
progress=true
loglevel=warn
